def scrape_jamku(gstin):
    empty = {col: "" for col in columns_order}

    if not gstin:
        return empty

    try:
        box = WebDriverWait(driver, 12).until(
            EC.presence_of_element_located((By.ID, "gstnosearch"))
        )
        box.clear()
        box.send_keys(gstin)

        btn = driver.find_element(
            By.XPATH,
            '//*[@id="__nuxt"]/div/div[2]/div/div/main/div[2]/div[2]/div/div/button'
        )
        btn.click()
    except:
        return empty

    time.sleep(random.uniform(3, 5))

    try:
        tbtn = driver.find_element(
            By.CSS_SELECTOR,
            'button.border.rounded.bg-gray-300.border-blue-300.p-2'
        )
        tbtn.click()
        time.sleep(1)
    except:
        pass

    out = empty.copy()

    try:
        parent = driver.find_element(
            By.XPATH,
            '//*[@id="__nuxt"]/div/div[2]/div/div/main/div[1]/section[1]/div[2]'
        )

        for div in parent.find_elements(By.TAG_NAME, "div"):
            text = div.text.strip()
            if "\n" in text:
                k, v = text.split("\n", 1)
                if k.strip() in out:
                    out[k.strip()] = v.strip()

    except:
        pass

    return out


