def smart_get(url, retries=3):
    if not isinstance(url, str) or not url.strip():
        return "Error: Invalid URL"

    url = url.strip()
    if not url.startswith(("http://", "https://")):
        url = "https://" + url

    for attempt in range(retries):
        try:
            headers = {
                "User-Agent": ua.random,
                "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
                "Accept-Language": "en-US,en;q=0.9",
            }
            res = requests.get(url, timeout=12, headers=headers, verify=False)
            if res.status_code == 200:
                return res.text
            if res.status_code in [403, 406, 429, 500, 502]:
                time.sleep(2 + attempt)
                continue
            return f"Error: HTTP {res.status_code}"
        except Exception as e:
            if attempt == retries - 1:
                return f"Error: {e}"
            time.sleep(1)

    return "Error: Max retries exceeded"


def extract_text(url):
    html = smart_get(url)
    if html is None or str(html).startswith("Error"):
        return html

    try:
        soup = BeautifulSoup(html, "lxml")
        for tag in soup(["script", "style", "noscript", "iframe"]):
            tag.decompose()
        return soup.get_text(" ", strip=True)
    except:
        return "Error parsing HTML"


