DEEPSEEK_URL = "https://api.deepseek.com/v1/chat/completions"
addr_headers = {
    "Content-Type": "application/json",
    "Authorization": f"Bearer {DEEPSEEK_API_KEY}"
}

# ------------------------------------------------------
# STEP A — Extract labeled addresses
# ------------------------------------------------------
def extract_labeled_addresses(text, max_addresses=5):
    prompt = f"""
You are an AI that extracts ALL complete postal addresses from website content.
Assign label like: Head Office, Registered Office, Factory, Plant, Branch, Sales Office, Warehouse etc.

Return STRICT JSON list only:
[
  {{"label": "Head Office", "address": "Plot 12, Industrial Area, Mumbai"}},
  {{"label": "Factory", "address": "GIDC Phase 2, Ahmedabad"}}
]

TEXT:
{text}
"""
    payload = {
        "model": "deepseek-chat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0
    }

    try:
        res = requests.post(DEEPSEEK_URL, headers=addr_headers, json=payload, timeout=30)
        raw = res.json()["choices"][0]["message"]["content"].strip().replace("\n", "")

        # Convert AI output → Python list
        arr = ast.literal_eval(raw) if raw.startswith("[") else []

        # 🔥 LIMIT TO MAX 5 ADDRESSES
        return arr[:max_addresses]

    except:
        return []



print("🔍 Extracting labeled addresses...")
df_addr["Raw Address Data"] = df_addr["Extracted Text"].fillna("").apply(extract_labeled_addresses)

# ------------------------------------------------------
# REORDER ADDRESSES BASED ON PRIORITY
# ------------------------------------------------------

PRIORITY_LABELS = [
    "Head Office",
    "Registered Office",
    "Corporate Office",
    "Corporate Address",
    "Registered Address"
]

def prioritize_addresses(addr_list):
    if not isinstance(addr_list, list):
        return []

    # 1️⃣ High-priority addresses first
    priority_items = [
        item for item in addr_list
        if any(item["label"].strip().lower() == p.lower() for p in PRIORITY_LABELS)
    ]

    # 2️⃣ Remaining addresses afterward
    other_items = [
        item for item in addr_list
        if item not in priority_items
    ]

    # 3️⃣ Combine
    return priority_items + other_items


# Apply prioritization
df_addr["Raw Address Data"] = df_addr["Raw Address Data"].apply(prioritize_addresses)


