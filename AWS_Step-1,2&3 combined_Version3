# STEP C — Extract city for each address
# ------------------------------------------------------
def extract_city(address):
    if not address.strip():
        return ""

    prompt = f"Extract ONLY the city name from this Indian address:\n{address}\nReturn ONLY the city."

    payload = {
        "model": "deepseek-chat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0
    }

    try:
        r = requests.post(DEEPSEEK_URL, headers=addr_headers, json=payload, timeout=20)
        return r.json()["choices"][0]["message"]["content"].strip()
    except:
        return "Error"


