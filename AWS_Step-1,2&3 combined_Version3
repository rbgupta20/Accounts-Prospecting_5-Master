# ======================================================
# SAFE HTML FETCHER (PREVENTS BINARY JUNK)
# ======================================================
def smart_get(url, retries=3):
    if not isinstance(url, str) or not url.strip():
        return None

    url = url.strip()

    # Ensure URL starts with http/https
    if not url.startswith(("http://", "https://")):
        url = "https://" + url

    MAX_SIZE = 2 * 1024 * 1024  # 2 MB

    for attempt in range(retries):
        try:
            headers = {
                "User-Agent": ua.random,
                "Accept": "*/*",
            }

            # stream=True allows us to check size *before loading full body*
            res = requests.get(url, timeout=12, headers=headers, verify=False, stream=True)

            content_type = res.headers.get("Content-Type", "").lower()
            if "text/html" not in content_type:
                return None

            # Check content size BEFORE downloading whole content
            content_length = res.headers.get("Content-Length")
            if content_length and int(content_length) > MAX_SIZE:
                print(f"⚠️ Skipping {url}: HTML too large ({content_length} bytes)")
                return None

            # If server does NOT send Content-Length, read in chunks with size cap
            bytes_read = 0
            html_chunks = []
            for chunk in res.iter_content(chunk_size=1024 * 32):  # 32 KB chunks
                bytes_read += len(chunk)
                if bytes_read > MAX_SIZE:
                    print(f"⚠️ Skipping {url}: exceeded 2MB while streaming")
                    return None
                html_chunks.append(chunk)

            html = b"".join(html_chunks).decode(res.apparent_encoding, errors="ignore")

            return html

        except Exception:
            if attempt == retries - 1:
                return None
            time.sleep(1)

    return None

# ======================================================
# EXTRACT CLEAN TEXT ONLY FROM VALID HTML
# ======================================================
def extract_text(url):
    html = smart_get(url)

    if html is None:
        return ""

    try:
        # Safety wrapper — auto skip if parsing blows up
        soup = BeautifulSoup(html, "lxml")

        # Remove noise
        for tag in soup(["script", "style", "noscript", "iframe"]):
            tag.decompose()

        text = soup.get_text(" ", strip=True)

        text = re.sub(r"[^\x09\x0A\x0D\x20-\x7E\u0080-\uFFFF]", "", text)

        return text[:50000]  # optional: keep text under 50k to avoid excessive API cost

    except Exception as e:
        print(f"⚠️ Skipping {url}: BeautifulSoup failed — {e}")
        return ""


