def normalize_url(url):
    parsed = urlparse(url)
    return urlunparse((parsed.scheme, parsed.netloc, parsed.path, '', '', ''))

def find_contact_pages(base_url):
    try:
        r = requests.get(base_url, headers=HEADERS, timeout=10)
        soup = BeautifulSoup(r.text, "lxml")
        candidates = []
        for link in soup.find_all('a', href=True):
            href = link['href'].lower()
            if any(kw in href for kw in ['contact', 'about', 'reach', 'support', 'help']):
                candidates.append(normalize_url(urljoin(base_url, href)))
        return list(set(candidates))
    except:
        return []

def extract_contacts_from_page(url):
    phones, emails = set(), set()

    try:
        res = requests.get(url, headers=HEADERS, timeout=12)
        soup = BeautifulSoup(res.text, "html.parser")
        visible = extract_visible_text(res.text)

        # Mailto:
        for a in soup.find_all("a", href=True):
            href = a["href"]
            if "mailto:" in href:
                mail = href.split("mailto:")[-1].split("?")[0].strip()
                if re.match(r"^[\w\.-]+@[\w\.-]+\.\w+$", mail):
                    emails.add(mail)

            if "tel:" in href:
                num = re.sub(r"\D", "", href.split("tel:")[-1])
                if len(num) == 10 and num[0] in "6789":
                    phones.add(num)

        # Emails in text
        emails.update(re.findall(r"[\w\.-]+@[\w\.-]+\.\w+", visible))

        # Phones in text
        raw_nums = re.findall(r'(?:\+91[\s\-]*)?(?:0)?([6-9][\d\-\s\.]{8,15}\d)', visible)
        for num in raw_nums:
            clean = re.sub(r"\D", "", num)
            if len(clean) == 10 and clean[0] in "6789":
                phones.add(clean)

    except:
        pass

    return phones, emails


