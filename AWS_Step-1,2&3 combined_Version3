def normalize_company_name(name):
    if not isinstance(name, str):
        return ""

    # Step 1 — Clean quotes & newlines
    name = name.replace("\n", " ").replace("\"", " ").strip()

    # Step 2 — Standard remove Pvt/Ltd variations
    name = name.replace("Pvt.", "Private").replace("pvt.", "Private")
    name = name.replace("Pvt", "Private").replace("pvt", "Private")
    name = name.replace("Ltd.", "Limited").replace("ltd.", "Limited")
    name = name.replace("Ltd", "Limited").replace("ltd", "Limited")

    # Step 3 — Remove special characters
    name = re.sub(r"[^A-Za-z0-9 ]+", " ", name)
    name = " ".join(name.split())

    return name.strip()




