import pandas as pd
import requests
import time
from tqdm import tqdm
from google.colab import files

# =====================================================================
# 🔑 STEP 1 — DeepSeek API Key
# =====================================================================

DEEPSEEK_API_KEY = input("Enter your DeepSeek API Key: ").strip()
DEEPSEEK_URL = "https://api.deepseek.com/v1/chat/completions"

headers = {
    "Content-Type": "application/json",
    "Authorization": f"Bearer {DEEPSEEK_API_KEY}"
}

# =====================================================================
# 📁 STEP 2 — Upload CSV (Company Link + Extracted Text)
# =====================================================================

print("📁 Please upload the CSV file containing company link + extracted text...")
uploaded = files.upload()

csv_filename = list(uploaded.keys())[0]
df = pd.read_csv(csv_filename)

print("\nColumns found:", df.columns.tolist())

LINK_COLUMN = "Company Link"
TEXT_COLUMN = "Extracted Text"

if TEXT_COLUMN not in df.columns:
    raise ValueError(f"Column '{TEXT_COLUMN}' not found in the CSV!")

if LINK_COLUMN not in df.columns:
    raise ValueError(f"Column '{LINK_COLUMN}' not found in the CSV!")


# =====================================================================
# 🤖 STEP 3 — DeepSeek: Extract Labeled Addresses
# =====================================================================

def extract_labeled_addresses(text):
    prompt = f"""
You are an AI that extracts ALL complete postal addresses from website content.
For each address, also extract the MOST LIKELY label based on context such as:

Head Office, Registered Office, Corporate Office, Branch Office,
Sales Office, Factory, Plant, Works, Warehouse, HO, RO, Marketing Office, Depot etc.

Return STRICTLY in JSON LIST format like this:

[
  {{"label": "Head Office", "address": "Plot 12, Industrial Area, Mumbai"}} ,
  {{"label": "Plant", "address": "GIDC Phase 2, Ahmedabad"}} ,
  {{"label": "Sales Office", "address": "MG Road, Delhi"}}
]

If no address is found, return: []
Do NOT add extra text outside the JSON.

TEXT:
{text}
"""

    payload = {
        "model": "deepseek-chat",
        "messages": [{"role": "user", "content": prompt}],
        "temperature": 0
    }

    try:
        response = requests.post(DEEPSEEK_URL, headers=headers, json=payload, timeout=30)
        raw = response.json()["choices"][0]["message"]["content"].strip()

        # Better JSON parsing without eval
        try:
            cleaned = raw.replace("\n", "").replace("\t", "")
            parsed = pd.json_normalize(eval(cleaned))  # keeping original eval logic style
            return eval(cleaned)
        except:
            return []

    except Exception as e:
        return [{"label": "API Error", "address": str(e)}]


# =====================================================================
# 🏃 STEP 4 — Process Each Row (Extract Addresses)
# =====================================================================

all_results = []

print("\n🔍 Extracting labeled addresses using DeepSeek...\n")

text_list = df[TEXT_COLUMN].fillna("").astype(str).tolist()

for text in tqdm(text_list):
    extracted = extract_labeled_addresses(text)
    all_results.append(extracted)

df["Raw Address Data"] = all_results


# =====================================================================
# 🧱 STEP 5 — Expand Into Address Columns
# =====================================================================

max_count = max(len(r) for r in all_results)
print(f"\n📌 Maximum labeled addresses found for any company: {max_count}\n")

for i in range(max_count):
    df[f"Address {i+1}"] = df["Raw Address Data"].apply(
        lambda arr: f"{arr[i]['label']}: {arr[i]['address']}" if i < len(arr) else ""
    )

df.drop(columns=["Raw Address Data"], inplace=True)


# =====================================================================
# 🌆 STEP 6 — DeepSeek Function to Extract City
# =====================================================================

def extract_city(address):
    if not isinstance(address, str) or address.strip() == "":
        return ""

    url = "https://api.deepseek.com/v1/chat/completions"

    payload = {
        "model": "deepseek-chat",
        "messages": [
            {
                "role": "user",
                "content": f"Extract ONLY the city name from this Indian address:\n\n{address}\n\nReturn only the city. If not found, return 'Unknown'."
            }
        ]
    }

    try:
        response = requests.post(url, json=payload, headers=headers, timeout=20)
        city = response.json()["choices"][0]["message"]["content"].strip()
        return city
    except:
        return "Error"


# =====================================================================
# 🏙️ STEP 7 — Create City Columns for Address 1 / Address 2 / ...
# =====================================================================

address_columns = [c for c in df.columns if c.startswith("Address ")]

for col in address_columns:
    print(f"🏙️ Extracting city for {col} ...")

    df[f"{col} City"] = [
        extract_city(addr) for addr in tqdm(df[col], desc=f"City → {col}")
    ]


# =====================================================================
# 💾 STEP 8 — Save Final Output
# =====================================================================

output_filename = "final_company_addresses_with_cities.csv"
df.to_csv(output_filename, index=False)

print(f"\n✅ DONE! Saved as: {output_filename}\n")

files.download(output_filename)
