DEEPSEEK_API_KEY = input("🔑 Enter your DeepSeek API key: ").strip()


# ======================================================
# GSTIN REGEX
# ======================================================
GSTIN_REGEX = re.compile(r"\b\d{2}[A-Z]{5}\d{4}[A-Z][A-Z\d]Z[A-Z\d]\b")


# ======================================================
# SERPER API CALL
# ======================================================
def fetch_raw_serper_response(company_name):
    url = "https://google.serper.dev/search"
    headers = {"X-API-KEY": SERPER_API_KEY, "Content-Type": "application/json"}
    payload = {"q": f"{company_name} GSTIN"}

    try:
        resp = requests.post(url, headers=headers, json=payload, timeout=30)
        resp.raise_for_status()
        return resp.json()
    except Exception as e:
        return {"error": str(e)}


# ======================================================
# GSTIN EXTRACTION
# ======================================================
def extract_gstins_best(company_name, raw_json):
    organic = raw_json.get("organic", [])
    gstin_scores = []

    for res in organic:
        text = " ".join([
            str(res.get("title", "")),
            str(res.get("snippet", "")),
            str(res.get("link", ""))
        ])

        found = GSTIN_REGEX.findall(text)
        for gstin in found:
            score = 0
            if company_name.lower() in text.lower():
                score += 3
            position = res.get("position", 10)
            score += max(0, 5 - position)
            gstin_scores.append((gstin, score))

    if not gstin_scores:
        return []

    score_map = {}
    for gstin, score in gstin_scores:
        score_map[gstin] = score_map.get(gstin, 0) + score

    best_score = max(score_map.values())
    return [gst for gst, score in score_map.items() if score == best_score]


def get_pan_from_gstin(gstin):
    if gstin:
        return gstin[2:12]
    return None


