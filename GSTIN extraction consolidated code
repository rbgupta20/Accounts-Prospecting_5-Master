driver.get("https://gst.jamku.app/gstin/08AAACZ4832E1ZD")
time.sleep(4)

columns_order = [
    'Trade Name', 'Legal Name', 'Registration Status', 'Registration Date',
    'Entity Type', 'Place of Business (Address)', 'E-Invoice mandatory?',
    'Aggregate Turnover', 'Central Jurisdiction', 'State Jurisdiction'
]

def scrape_jamku(gstin):
    empty = {col: "" for col in columns_order}
    if pd.isna(gstin) or gstin == "":
        return empty

    try:
        box = WebDriverWait(driver, 12).until(
            EC.presence_of_element_located((By.ID, "gstnosearch"))
        )
        box.clear()
        box.send_keys(gstin)

        btn = driver.find_element(
            By.XPATH,
            '//*[@id="__nuxt"]/div/div[2]/div/div/main/div[2]/div[2]/div/div/button'
        )
        btn.click()
    except:
        return empty

    time.sleep(random.uniform(3, 5))

    try:
        tbtn = driver.find_element(
            By.CSS_SELECTOR,
            'button.border.rounded.bg-gray-300.border-blue-300.p-2'
        )
        tbtn.click()
        time.sleep(1)
    except:
        pass

    out = empty.copy()
    try:
        parent = driver.find_element(
            By.XPATH,
            '//*[@id="__nuxt"]/div/div[2]/div/div/main/div[1]/section[1]/div[2]'
        )
        for div in parent.find_elements(By.TAG_NAME, "div"):
            text = div.text.strip()
            if "\n" in text:
                k, v = text.split("\n", 1)
                if k.strip() in out:
                    out[k.strip()] = v.strip()
    except:
        pass

    return out


print("\n🧾 Scraping Jamku...")
jamku_rows = []
cache = {}

for i, row in tqdm(df.iterrows(), total=len(df)):
    gstin = row["GSTIN"]

    if gstin not in cache:
        cache[gstin] = scrape_jamku(gstin)

    jamku_rows.append({
        "Company Name": row["Company Name"],
        "Serper Raw Response": row["Serper Raw Response"],
        "GSTIN": gstin,
        **cache[gstin]
    })

driver.quit()

df_jamku = pd.DataFrame(jamku_rows)


# ======================================================
# STEP 4: DEEPSEEK SEMANTIC NAME MATCHING (UPDATED + FIXED)
# ======================================================
def clean_deepseek_json(raw_text):
    """Fix DeepSeek JSON by removing code fences, escapes, extra quotes."""
    if not raw_text:
        return raw_text

    txt = raw_text.strip()

    # Remove ```json ... ```
    if txt.startswith("```"):
        txt = txt.replace("```json", "").replace("```", "").strip()

    # Remove wrapped quotes
    if txt.startswith('"') and txt.endswith('"'):
        txt = txt[1:-1]

    # Unescape quotes
    txt = txt.replace('\\"', '"')

    return txt.strip()


def check_name_match(company_name, trade_name, legal_name):
    prompt = f"""
    Compare the following names and determine if they refer to the same company.

    Input Company Name: {company_name}
    Jamku Trade Name: {trade_name}
    Jamku Legal Name: {legal_name}

    Rules:
    - Ignore Pvt, Private, Limited, Ltd
    - Ignore formatting differences
    - If Trade Name OR Legal Name matches semantically → "Matched"
    
    Respond ONLY in JSON:
    {{
      "match": "Matched" or "Not Matched",
      "reason": "short explanation"
    }}
    """

    url = "https://api.deepseek.com/chat/completions"
    headers = {
        "Authorization": f"Bearer {DEEPSEEK_API_KEY}",
        "Content-Type": "application/json"
    }
    payload = {
        "model": "deepseek-chat",
        "messages": [
            {"role": "system", "content": "You are a company identity verifier."},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.2
    }

    try:
        resp = requests.post(url, headers=headers, json=payload, timeout=30)
        resp.raise_for_status()
        raw = resp.json()["choices"][0]["message"]["content"]

        cleaned = clean_deepseek_json(raw)

        try:
            parsed = json.loads(cleaned)
            return parsed.get("match", ""), parsed.get("reason", ""), raw
        except:
            return "Error", "Invalid JSON (after cleaning)", raw

    except Exception as e:
        return "Error", str(e), ""


print("\n🤖 Running DeepSeek name matching...")
results = []

for _, row in tqdm(df_jamku.iterrows(), total=len(df_jamku)):
    company = row["Company Name"]
    trade    = row["Trade Name"]
    legal    = row["Legal Name"]

    match, reason, raw_json = check_name_match(company, trade, legal)

    row["Name Match?"] = match
    row["Name Match Reason"] = reason
    row["Name Match Raw JSON"] = raw_json

    results.append(row)


# ======================================================
